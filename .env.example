# PostgreSQL connection string (dev DB).
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/device-mapper

# Separate, empty database used ONLY by `npm test`. Its public schema is
# dropped and recreated for every DB test file, so never point it at real data.
# Tests refuse to run if this equals DATABASE_URL.
TEST_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/device-mapper-test

# Random secret used to sign sessions. Must be at least 32 characters.
# Generate one with: openssl rand -base64 32
BETTER_AUTH_SECRET=change-me-32-chars-min-please-change
# Public base URL of the app. Optional in dev (localhost/LAN hosts are trusted).
BETTER_AUTH_URL=http://localhost:3000

# Comma-separated list of extra origins allowed to call the auth API,
# beyond the localhost/LAN patterns src/lib/auth.ts already trusts.
TRUSTED_ORIGINS=http://localhost:3000

# Admin account created by `npm run db:seed` (required by that script only).
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=change-me

# Timezone for timestamps.
TZ=Asia/Jakarta

# Satellite tiles (Esri World Imagery, no API key). Swap the URL to change provider.
NEXT_PUBLIC_TILE_URL=https://server.arcgisonline.com/ArcGIS/rest/services/World_Imagery/MapServer/tile/{z}/{y}/{x}
NEXT_PUBLIC_TILE_ATTRIBUTION="Tiles © Esri — Source: Esri, Maxar, Earthstar Geographics, and the GIS User Community"
NEXT_PUBLIC_TILE_MAX_ZOOM=19

# Default map view (plant area).
NEXT_PUBLIC_DEFAULT_CENTER_LAT=-2.9961
NEXT_PUBLIC_DEFAULT_CENTER_LNG=104.8396
NEXT_PUBLIC_DEFAULT_ZOOM=16
