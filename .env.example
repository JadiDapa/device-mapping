# SQLite database file path.
DATABASE_PATH=./data/app.db

# Directory for user uploads (serve via a route handler, not public/).
UPLOAD_DIR=./data/uploads

# Random secret used to sign sessions. Must be at least 32 characters.
# Generate one with: openssl rand -base64 32
BETTER_AUTH_SECRET=change-me-32-chars-min-please-change

# Comma-separated list of extra origins allowed to call the auth API,
# beyond the localhost/LAN patterns lib/auth.ts already trusts.
TRUSTED_ORIGINS=http://localhost:3000

# Admin account seeded on first boot if no user exists yet.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me

# Timezone for timestamps.
TZ=UTC
